{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "the-ai-music-generator",
  "workers_dev": true,
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "theaimusicgenerator.com",
      "custom_domain": true
    },
    {
      "pattern": "www.theaimusicgenerator.com",
      "custom_domain": true
    },
    {
      "pattern": "app.theaimusicgenerator.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_DATABASE",
        "class_name": "AppDatabase",
        "script_name": "the-ai-music-generator-db"
      }
    ]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "the-ai-music-generator"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "the-ai-music-generator-media"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
