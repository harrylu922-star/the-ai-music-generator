{
  "name": "the-ai-music-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "compression": "1.8.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean && next build",
    "prebuild": "node scripts/verify-og-image.js",
    "clean": "node scripts/clean.js",
    "start": "next start",
    "lint": "eslint",
    "verify:og": "node scripts/verify-og-image.js",
    "optimize:images": "node scripts/optimize-images.js",
    "lighthouse": "npx --yes lighthouse http://localhost:3000 --only-categories=performance --output=html --output-path=./lighthouse-report.html --chrome-flags=--headless",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run deploy:workers",
    "deploy:db": "wrangler deploy --config backend/wrangler.jsonc",
    "deploy:workers": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "image-size": "^2.0.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.151.3"
  }
}
