# Production application origin used by the Worker, redirects, and metadata.
NEXT_PUBLIC_SITE_URL=https://theaimusicgenerator.com

# Music provider: generic HTTPS JSON API using Bearer authentication.
MUSIC_PROVIDER=cqtai
MUSIC_MODEL=v50
MUSIC_GENERATE_URL=
MUSIC_STATUS_URL=
MUSIC_API_KEY=

# Stripe server-side configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_ADVANCED_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_ADVANCED_ANNUAL=
STRIPE_PRICE_CREDITS_1600=
STRIPE_PRICE_CREDITS_4000=
